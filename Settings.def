
// xmacro file for .ini setting definition
// format: (type, cname, ininame, default value) 
	
// Graphics Options
SETTING(unsigned, RenderWidth, "renderWidth", 1024);
SETTING(unsigned, RenderHeight, "renderHeight", 720);
SETTING(unsigned, FilteringOverride, "filteringOverride", 0);

SETTING(unsigned, DOFOverrideResolution, "dofOverrideResolution", 0);
SETTING(bool, DisableDofScaling, "disableDofScaling", false);
SETTING(unsigned, DOFBlurAmount, "dofBlurAmount", 0);

SETTING(unsigned, AAQuality, "aaQuality", 0);
SETTING(std::string, AAType, "aaType", "FXAA");
// sharpenStrength: contrast-adaptive sharpening of the 3D image after AA (not the HUD or menus). 0 = off, up to 1.0
SETTING(float, SharpenStrength, "sharpenStrength", 0.0f);

SETTING(unsigned, SsaoStrength, "ssaoStrength", 0);
SETTING(unsigned, SsaoScale, "ssaoScale", 0);
// ssaoType: VSSAO, VSSAO2, HBAO or SCAO (any other name uses SCAO)
SETTING(std::string, SsaoType, "ssaoType", "VSSAO");

SETTING(bool, UnlockFPS, "unlockFPS", 0);
SETTING(unsigned, FPSLimit, "FPSlimit", 30);
SETTING(unsigned, FPSThreshold, "FPSthreshold", 28);

SETTING(bool, EnableTripleBuffering, "enableTripleBuffering", 0);

// Logging Options
SETTING(unsigned, LogLevel, "logLevel", 0);
	
// Cursor Options
SETTING(bool, DisableCursor, "disableCursor", false);
SETTING(bool, CaptureCursor, "captureCursor", false);
	
// Language Options
SETTING(std::string, OverrideLanguage, "overrideLanguage", "");

// Skipping Options
SETTING(bool, SkipIntro, "skipIntro", false);

// Backup Options
SETTING(bool, EnableBackups, "enableBackups", false);
SETTING(unsigned, BackupInterval, "backupInterval", 1500);
SETTING(unsigned, MaxBackups, "maxBackups", 20);

// Wrapper chaining options
SETTING(std::string, Dinput8dllWrapper, "dinput8dllWrapper", "");

// Folder options
SETTING(std::string, ScreenshotDir, "screenshotDir", ".");

// Texture Override Options
SETTING(bool, EnableTextureDumping, "enableTextureDumping", false);
SETTING(bool, EnableTextureOverride, "enableTextureOverride", false);
SETTING(bool, EnableTexturePrefetch, "enableTexturePrefetch", false);

// Shader Override Options
SETTING(bool, EnableShaderDumping, "enableShaderDumping", false);
SETTING(bool, EnableShaderOverride, "enableShaderOverride", false);

// HUD options
SETTING(bool, EnableHudMod, "enableHudMod", false)
SETTING(float, HudScaleTopLeft, "hudScaleTopLeft", 1.0f)
SETTING(float, HudScaleBottomLeft, "hudScaleBottomLeft", 1.0f)
SETTING(float, HudScaleBottomRight, "hudScaleBottomRight", 1.0f)
SETTING(float, HudScaleBottomCenter, "hudScaleBottomCenter", 1.0f)
SETTING(float, HudBottomLeftWidth, "hudBottomLeftWidth", 0.30f)
SETTING(float, HudBottomRightLeft, "hudBottomRightLeft", 0.84f)
SETTING(float, HudBottomRightTop, "hudBottomRightTop", 0.86f)
SETTING(float, HudTopLeftOpacity, "hudTopLeftOpacity", 1.0f)
SETTING(float, HudBottomLeftOpacity, "hudBottomLeftOpacity", 1.0f)
SETTING(float, HudBottomRightOpacity, "hudBottomRightOpacity", 1.0f)
// Window scaling (in game, needs enableHudMod). 1.0 = unchanged; smaller shrinks the window (lowest 0.5).
// menuScale: quick menu and main menu (Inventory, Equipment, Magic, Status, System, Level Up, their popups), toward the top-right corner
// listWindowScale: bonfire menu and the other list windows on the left (NPC choices), toward their top-left corner
// promptScale: interaction prompts, yes/no questions and item pickup popups, toward the bottom centre
// subtitleScale: NPC dialogue subtitles, toward the bottom centre
SETTING(float, MenuScale, "menuScale", 1.0f)
SETTING(float, ListWindowScale, "listWindowScale", 1.0f)
SETTING(float, PromptScale, "promptScale", 1.0f)
SETTING(float, SubtitleScale, "subtitleScale", 1.0f)
// swapConfirmIcons: shows the B / circle icon wherever the game shows A / cross and the other way round (button prompts, menu hints).
// For Japanese-style controls (circle = confirm) set up in Steam Input, DS4Windows or another controller mapper.
SETTING(bool, SwapConfirmIcons, "swapConfirmIcons", false)
// swapXYIcons: shows the Y / triangle icon wherever the game shows X / square and the other way round.
SETTING(bool, SwapXYIcons, "swapXYIcons", false)
// controllerIcons: button prompt and quick menu icons for your controller, built into DSfix.
//   off         - as before: the game's icons, or your own files in tex_override (40fbc4ad / 43a2b23a)
//   auto        - the controller connected when the game starts: PlayStation, Switch Pro or Xbox (if both a
//                 PlayStation / Switch pad and an Xbox pad are found, the PlayStation / Switch one is used);
//                 no controller found: as with off
//   xbox, playstation, switch - always that set
// When a set is used, files with those two names in tex_override are ignored.
SETTING(std::string, ControllerIcons, "controllerIcons", "off")

// Screen Options
SETTING(bool, BorderlessFullscreen, "borderlessFullscreen", false);
SETTING(unsigned, PresentWidth, "presentWidth", 0);
SETTING(unsigned, PresentHeight, "presentHeight", 0);
// enableVsync and fullscreenHz act only in the game's own fullscreen mode (not in a window or borderless window).
// enableVsync: -1 = leave the game's choice (default), 0 = vsync off, 1 = vsync on
// fullscreenHz: 0 = leave the game's choice (default), otherwise the refresh rate to use (checked against the monitor)
SETTING(int, EnableVsync, "enableVsync", -1);
SETTING(unsigned, FullscreenHz, "fullscreenHz", 0);
SETTING(int, D3DAdapterOverride, "d3dAdapterOverride", -1);


